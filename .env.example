# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_DEBUG_IMPORT=false
VITE_DEBUG_SESSION=false
VITE_DEBUG_PROGRESS=false
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# Backend
DATABASE_URL=sqlite:///./apps/api/.data/memory_assistant.db
# Local PostgreSQL example:
# DATABASE_URL=postgresql://memory_user:memory_password@localhost:5432/memory_assistant
# Vercel Neon production uses the pooled DATABASE_URL injected by the Vercel Marketplace integration.
GOOGLE_CLIENT_ID=
# JWT_SECRET is not required by the current bearer-token implementation.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=warn
DEBUG_IMPORT=false
DEBUG_SESSION=false
DEBUG_PROGRESS=false
DEBUG_AUTH=false
AUTH_TOKEN_TTL_HOURS=168
