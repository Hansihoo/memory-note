{
  "name": "memory-assistant-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build && vite build --config vite.background.config.ts && vite build --config vite.options.config.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-extension.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"public/**/*.json\""
  },
  "dependencies": {
    "@memory-note/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
